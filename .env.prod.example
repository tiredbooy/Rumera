# ──────────────────────────────────────────────────────────────────────────────
# Rumera — PRODUCTION environment template.
#
#   cp .env.prod.example .env.prod        (or run:  make env)
#   then edit EVERY value marked [REQUIRED] — the prod stack fails fast if a
#   required secret is missing (by design).
#
# Used by docker-compose.prod.yml via:  docker compose --env-file .env.prod ...
#
# Hardening notes:
#   • Databases & Redis are NOT published to the host in prod — they live only on
#     the internal Docker network. Front the stack with a TLS reverse proxy.
#   • Generate secrets, don't reuse the dev ones:
#         openssl rand -base64 32      # AUTH_SECRET / JWT_SECRET
#         openssl rand -hex 16         # passwords / MEILI key
# ──────────────────────────────────────────────────────────────────────────────

# ── Auth (REQUIRED) ───────────────────────────────────────────────────────────
# Auth.js (frontend service only — injected by docker-compose.prod.yml).
AUTH_SECRET=                 # [REQUIRED] openssl rand -base64 32
AUTH_URL=https://rumera.example.com   # public storefront origin (callbacks)
# Backend JWT signing secret (API access/refresh tokens). Separate from AUTH_SECRET.
JWT_SECRET=                  # [REQUIRED] long & random, separate from AUTH_SECRET
JWT_ACCESS_TTL=15            # minutes
JWT_REFRESH_TTL=10080        # minutes (7 days)

# Prometheus /metrics — required when METRICS_ENABLED=true (the default).
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=        # [REQUIRED] openssl rand -hex 32

# Bootstrap admin (first boot only). Leave blank to skip after the first deploy.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── SMS / OTP login ───────────────────────────────────────────────────────────
# Use a real gateway in production so phone login works. Falls back to "log".
SMS_PROVIDER=kavenegar       # or "log" to disable real sending
SMS_API_KEY=                 # [REQUIRED if SMS_PROVIDER=kavenegar]
SMS_SENDER=                  # your approved sender line (optional)
OTP_TTL=2m

# ── Loyalty (Cellar Club) ─────────────────────────────────────────────────────
LOYALTY_EARN_DIVISOR=10000   # Toman spent per point earned
LOYALTY_REDEEM_VALUE=1000    # Toman of wallet credit per point redeemed
LOYALTY_SIGNUP_BONUS=100     # one-time welcome points (0 to disable)

# ── Public URLs & cross-app communication (REQUIRED) ──────────────────────────
# Canonical storefront origin — inlined into the build (SEO/OG/sitemap) and used
# by next-auth callbacks.
NEXT_PUBLIC_SITE_URL=https://rumera.example.com
# Browser-facing API origin. Must be reachable from the public internet (usually
# the same domain via a reverse-proxy path, e.g. https://rumera.example.com/api).
NEXT_PUBLIC_API_URL=https://rumera.example.com
# Server→API traffic stays internal (compose sets BACKEND_INTERNAL_URL=http://backend:8080).

# Server→Prometheus traffic. The production observability compose joins the same
# network, where its service DNS name is `prometheus`.
PROMETHEUS_URL=http://prometheus:9090
# Browser-facing Grafana URL (normally HTTPS behind an authenticated proxy).
NEXT_PUBLIC_GRAFANA_URL=https://grafana.rumera.example.com

# CORS allow-list — the public origin(s) of the storefront. [REQUIRED]
CORS_ALLOWED_ORIGINS=https://rumera.example.com

# CIDRs Gin trusts for X-Forwarded-For / c.ClientIP(). [REQUIRED in production]
# Compose defaults this to the Docker user-defined bridge range (nginx → backend).
# Do not set 0.0.0.0/0 — that re-enables XFF spoofing of login/OTP rate limits.
# Prod nginx resets X-Forwarded-For to $remote_addr (does not append client XFF).
TRUSTED_PROXIES=172.16.0.0/12

# Gateway pay-start origin. Intents append ?transaction_id=<id>. [REQUIRED]
PAYMENT_START_BASE_URL=https://pay.example.com/start

# ── Main database (REQUIRED) ──────────────────────────────────────────────────
DB_USER=rumera
DB_PASSWORD=                 # [REQUIRED] strong secret
DB_NAME=rumera
DB_SSL_MODE=disable          # 'require' if your DB enforces TLS

# ── Analytics database (REQUIRED) ─────────────────────────────────────────────
ANALYTICS_DB_USER=rumera
ANALYTICS_DB_PASSWORD=       # [REQUIRED]
ANALYTICS_DB_NAME=rumera_analytics
ANALYTICS_DB_SSL_MODE=disable

# ── Cache (REQUIRED) ──────────────────────────────────────────────────────────
REDIS_PASSWORD=              # [REQUIRED]

# ── Search (REQUIRED) ─────────────────────────────────────────────────────────
MEILI_API_KEY=              # [REQUIRED] master key

# ── Media hardening ────────────────────────────────────────────────────────────
MEDIA_MAX_UPLOAD_MB=15
MEDIA_DEFAULT_QUALITY=80
MEDIA_MAX_DIMENSION=4000
MEDIA_MAX_SOURCE_DIMENSION=12000
MEDIA_MAX_SOURCE_PIXELS=40000000

# ── Domain events (transactional outbox) ──────────────────────────────────────
# Paid-order side effects — receipt email, loyalty + referral award, and the
# recommendation signal — run as idempotent consumers of order.paid.v1 instead
# of on the checkout request path. The fact is written to domain_events in the
# SAME transaction as the money, so it can never disagree with the ledger, and a
# failed consumer retries with backoff and eventually dead-letters instead of
# being silently lost.
#
# Leave EVENTS_BUS=postgres in production unless you have actually deployed a
# broker (apps/backend/deploy/kafka/docker-compose.kafka.prod.yml — a separate,
# opt-in stack). Postgres mode needs no extra infrastructure.
#
# EVENTS_ENABLED=false is the emergency lever: producers stop enqueuing and the
# legacy in-request side effects take back over. Flip it and restart backend.
#
# EVENTS_WORKER=external: the API replicas only emit, the event-worker service
# in docker-compose.prod.yml runs the consumers. Use "embedded" (and scale
# event-worker to 0) for a single-process deployment. "off" is rejected at boot
# while EVENTS_ENABLED=true — nothing would consume the facts.
EVENTS_ENABLED=true
EVENTS_BUS=postgres
EVENTS_WORKER=external

# Retry budget and retention. Dead-lettered consumptions are never pruned, so a
# failure stays replayable after you fix its cause.
EVENTS_MAX_ATTEMPTS=8
EVENTS_BACKOFF_BASE=2s
EVENTS_BACKOFF_MAX=1h
EVENTS_RETENTION=720h

# Staleness gate on the Postgres fan-out fallback in Kafka mode (K-4). Without it
# a broker outage stops every order.paid side effect; with it the outage costs
# this much delay. Do not raise it above EVENTS_BACKOFF_MAX — a row that failed
# to publish ~11 times would otherwise stay parked for the full hour.
EVENTS_FALLBACK_AFTER=5m

# Consumer group id (kafka bus only) and how many handlers run at once. Keep
# EVENTS_CONCURRENCY well under the DB pool size — each handler holds a conn.
EVENTS_CONSUMER_GROUP=rumera-event-worker
EVENTS_CONCURRENCY=4

# Alert on these: event_outbox_lag_seconds climbing means consumers are behind
# or the worker is down; any increase in event_dlq_total needs a human.

# ── Kafka broker (only when EVENTS_BUS=kafka or NOTIFICATIONS_MODE=async) ─────
# Bring the broker up with:
#   docker compose -f apps/backend/deploy/kafka/docker-compose.kafka.prod.yml up -d
# It has no published host ports, so the only address that works is the
# in-network one. Leave KAFKA_BROKERS empty to run with no broker at all.
# NOTE: compose's --env-file parser does NOT strip a trailing `# comment` from an
# unquoted value, so anything meant to be EMPTY keeps its comment on its own line.
# (A leaked comment in KAFKA_SASL_MECHANISM is an invalid mechanism and the
# backend refuses to boot.)
# e.g. redpanda:9092 — empty = no broker
KAFKA_BROKERS=
NOTIFICATIONS_MODE=inline            # "async" needs KAFKA_BROKERS + notification-worker
NOTIFICATION_WORKER_GROUP=rumera-notification-worker

# SASL/SCRAM. These are BOTH the broker's bootstrap superuser (the kafka prod
# compose reads them) and the backend's client credentials — one account, so
# they must match. Generate a strong password.
#
# Left EMPTY on purpose, matching the Go default (empty = dial unauthenticated)
# and the EVENTS_BUS=postgres default above: a stock copy of this file runs with
# no broker, so shipping a mechanism pre-enabled would mean SASL is "on" with no
# credentials behind it. Set all three together, only when you deploy the broker.
# scram-sha-512 or scram-sha-256; empty = dial unauthenticated
KAFKA_SASL_MECHANISM=
# [REQUIRED for kafka] e.g. rumera
KAFKA_SASL_USERNAME=
# [REQUIRED for kafka] strong secret, do not commit
KAFKA_SASL_PASSWORD=

# TLS to the broker. false is correct for the bundled compose: it listens only
# on the internal docker network and terminates no TLS. Set true only when
# pointing KAFKA_BROKERS at a managed/TLS broker.
KAFKA_TLS_ENABLED=false

# ── Network binding ───────────────────────────────────────────────────────────
# Keep the API on loopback behind your reverse proxy; expose only the storefront.
BACKEND_BIND=127.0.0.1
FRONTEND_BIND=0.0.0.0
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ── Reverse proxy / unified gateway (nginx) ───────────────────────────────────
# Public entry point. /api/v1/* → backend, /* → frontend. Terminate TLS here
# (see infra/nginx/nginx.prod.conf and the commented 443 block + cert volume in
# docker-compose.prod.yml). NEXT_PUBLIC_API_URL/SITE_URL above should point at
# this gateway's public origin.
GATEWAY_PORT=80
