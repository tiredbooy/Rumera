# ──────────────────────────────────────────────────────────────────────────────
# Rumera — environment template for the root Docker Compose stacks.
#
#   cp .env.example .env      then edit the values below.
#
# DEV  (docker-compose.dev.yml):  every value has a built-in default, so .env is
#                                 entirely optional — copy only what you want to
#                                 override.
# PROD (docker-compose.prod.yml): the variables marked [REQUIRED] must be set or
#                                 the stack refuses to start (fail-fast by design).
# ──────────────────────────────────────────────────────────────────────────────

# ── Main database (PostgreSQL / TimescaleDB) ──────────────────────────────────
DB_USER=postgres
DB_PASSWORD=postgres            # [REQUIRED in prod] use a strong secret
DB_NAME=rumera
DB_PORT=5432                    # host port (dev only)
DB_SSL_MODE=disable

# ── Analytics database (TimescaleDB) ──────────────────────────────────────────
ANALYTICS_DB_USER=postgres
ANALYTICS_DB_PASSWORD=postgres  # [REQUIRED in prod]
ANALYTICS_DB_NAME=rumera_analytics
ANALYTICS_DB_HOST_PORT=5433     # host port (dev only)
ANALYTICS_DB_SSL_MODE=disable

# ── Cache (Redis) ─────────────────────────────────────────────────────────────
REDIS_PASSWORD=                 # [REQUIRED in prod] (dev runs without auth)
REDIS_PORT=6379                 # host port (dev only)

# ── Search (Meilisearch) ──────────────────────────────────────────────────────
MEILI_API_KEY=super_secret_key  # [REQUIRED in prod]
MEILI_PORT=7700                 # host port (dev only)

# ── Media (product images) ────────────────────────────────────────────────────
# Originals + the rendered cache live on the `media_data` volume inside the
# backend container (MEDIA_ROOT/MEDIA_CACHE_DIR are fixed to /data/* in compose).
# These knobs are optional — the Go service has sane defaults.
MEDIA_MAX_UPLOAD_MB=15          # reject uploads larger than this
MEDIA_DEFAULT_QUALITY=80        # output quality when ?q= is omitted (1–100)
MEDIA_MAX_DIMENSION=4000        # clamp requested transform width/height
MEDIA_MAX_SOURCE_DIMENSION=12000 # reject a source with either axis above this
MEDIA_MAX_SOURCE_PIXELS=40000000 # reject decompression-bomb-sized sources

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-insecure-jwt-secret-change-me   # [REQUIRED in prod] long & random
JWT_ACCESS_TTL=15               # minutes
JWT_REFRESH_TTL=10080           # minutes (7 days)

# Prometheus /metrics. In production METRICS_ENABLED=true requires a bearer token.
METRICS_ENABLED=true
# METRICS_BEARER_TOKEN=            # [REQUIRED in prod when metrics on] scrape secret

# Bootstrap admin (created on first boot if it doesn't exist). Leave blank to skip.
ADMIN_EMAIL=admin@rumera.local
ADMIN_PASSWORD=admin12345

# ── Networking / ports ────────────────────────────────────────────────────────
BACKEND_PORT=8080
FRONTEND_PORT=3000
BACKEND_BIND=127.0.0.1          # prod: bind the API to loopback behind a proxy
FRONTEND_BIND=0.0.0.0           # prod: expose the storefront

# CORS allow-list for the API (comma-separated). [REQUIRED in prod]
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Notifications (optional async path) ───────────────────────────────────────
# Default inline is enough for local (OTP/email via SMS_PROVIDER / mailer).
# Set async + brokers only when running the Kafka worker cutover.
NOTIFICATIONS_MODE=inline
# KAFKA_BROKERS=localhost:19092
# NOTIFICATION_WORKER_GROUP=rumera-notification-worker
# NOTIFICATION_WORKER_MODE=all

# SMS gateway origin. Override to point staging at a sandbox/mock gateway.
# SMS_BASE_URL=https://api.kavenegar.com/v1
# SMS_TIMEOUT=8s

# ── Domain events (transactional outbox) ──────────────────────────────────────
# Facts ("the order was paid") written to domain_events in the SAME Postgres
# transaction as the money, then fanned out to idempotent consumers (receipt
# email, loyalty + referral award, recommendation signal). This is what moves
# those side effects off the checkout request path.
#
# Distinct from notification_outbox above, which carries COMMANDS ("send this
# SMS"). Facts fan out to many consumers; commands have exactly one deliverer.

# Master switch. false reverts to the legacy in-request side effects — the
# escape hatch if the bus ever misbehaves in production. Never run with the bus
# half-on: producers and consumers are gated by this single flag so exactly one
# path is ever active and nothing is awarded twice.
EVENTS_ENABLED=true

# Transport. "postgres" (default) consumes straight from the outbox and needs no
# broker — this is the only mode that works today in dev, CI and prod.
# "kafka" relays facts to a topic first; it additionally requires KAFKA_BROKERS,
# a reachable broker (see apps/backend/deploy/kafka), and the topics created.
# Consumers behave identically either way.
EVENTS_BUS=postgres

# Where consumers run. "embedded" runs them inside the API process (default),
# "external" when cmd/event-worker owns them. "off" is only valid with
# EVENTS_ENABLED=false — otherwise nothing would consume the emitted facts.
EVENTS_WORKER=embedded
# EVENTS_CONSUMER_GROUP=rumera-event-worker

# Loop tuning. Defaults trade ~1s of side-effect latency for negligible idle
# query load. Lower the intervals if a consumer needs to feel instant.
# EVENTS_FANOUT_INTERVAL=1s
# EVENTS_FANOUT_BATCH=100
# EVENTS_CONSUME_INTERVAL=1s
# EVENTS_CONSUME_BATCH=50
# EVENTS_RELAY_INTERVAL=1s
# EVENTS_RELAY_BATCH=100
# Handlers running concurrently. Each holds a pool connection — keep well under
# the DB pool size.
# EVENTS_CONCURRENCY=4

# Retry budget. A failing consumer backs off exponentially between BACKOFF_BASE
# and BACKOFF_MAX, then dead-letters after MAX_ATTEMPTS. Permanent failures
# (malformed payload, unconfigured provider) skip the budget and dead-letter at
# once. Dead-lettered rows are replayable and are never pruned.
# EVENTS_MAX_ATTEMPTS=8
# EVENTS_BACKOFF_BASE=2s
# EVENTS_BACKOFF_MAX=1h
# EVENTS_HANDLER_TIMEOUT=30s
# EVENTS_METRICS_INTERVAL=15s

# Staleness gate on the Postgres fan-out fallback in Kafka mode (K-4). A fact the
# broker has not delivered within this window is fanned out locally instead, so a
# broker outage delays order.paid side effects by minutes rather than stopping
# them. Ignored when EVENTS_BUS=postgres. Keep it well below EVENTS_BACKOFF_MAX —
# this is what makes the single-broker/RF=1 decision safe.
# EVENTS_FALLBACK_AFTER=5m

# Retention for fully-settled facts. Anything still pending, retrying or
# dead-lettered is kept regardless of age so it stays replayable.
# EVENTS_RETENTION=720h
# CRON_EVENTS_PRUNE_SCHEDULE=0 45 3 * * *

# Gateway pay-start origin (PR-005a). Intents append ?transaction_id=<id>.
# Required in production. Empty in development leaves payment_url blank.
# PAYMENT_START_BASE_URL=https://pay.example.com/start

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# Public canonical URL of the storefront — inlined into the build, used for SEO
# (canonical/OG tags), sitemap.xml and robots.txt. [REQUIRED in prod]
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Browser-facing base URL of the API. [REQUIRED in prod]
NEXT_PUBLIC_API_URL=http://localhost:8080
# Auth.js session signing (frontend container). [REQUIRED in prod]
# Generate with: openssl rand -base64 32  — do not reuse JWT_SECRET.
AUTH_SECRET=dev-insecure-auth-secret-change-me-0000000000000000
# Public storefront origin Auth.js uses for callbacks. Same as NEXT_PUBLIC_SITE_URL
# in typical deploys. [REQUIRED in prod]
AUTH_URL=http://localhost:3000
# Optional media transform origin (defaults to NEXT_PUBLIC_API_URL, then same-origin).
# Must be https:// in production when set.
# NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:8080
