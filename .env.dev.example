# ──────────────────────────────────────────────────────────────────────────────
# Rumera — DEVELOPMENT environment template.
#
#   cp .env.dev.example .env.dev        (or run:  make env)
#
# Used by docker-compose.dev.yml via:  docker compose --env-file .env.dev ...
#
# Every value here already has a sensible default baked into the compose file,
# so .env.dev is mostly about ONE thing you must not skip: AUTH_SECRET (the
# Next.js / next-auth signing key has no default — the frontend won't start
# without it). Everything else you can leave as-is for local development.
# ──────────────────────────────────────────────────────────────────────────────

# ── Auth (REQUIRED — no default) ──────────────────────────────────────────────
# next-auth signing secret. Generate a fresh one with:  openssl rand -base64 32
AUTH_SECRET=dev-insecure-auth-secret-change-me-0000000000000000
AUTH_URL=http://localhost:3000

# Backend JWT signing secret (issues the API access/refresh tokens).
JWT_SECRET=dev-insecure-jwt-secret-change-me
JWT_ACCESS_TTL=15            # minutes
JWT_REFRESH_TTL=10080        # minutes (7 days)

# Bootstrap admin, created on first boot if it doesn't exist. Blank = skip.
ADMIN_EMAIL=admin@rumera.local
ADMIN_PASSWORD=admin12345

# ── SMS / OTP login ───────────────────────────────────────────────────────────
# "log" (default) just writes the OTP code to the backend logs — perfect for dev,
# no SMS account needed. Switch to "kavenegar" + a key in prod.
SMS_PROVIDER=log
# SMS_API_KEY=
# SMS_SENDER=
OTP_TTL=2m

# ── Loyalty (Cellar Club) ─────────────────────────────────────────────────────
# Earn 1 point per LOYALTY_EARN_DIVISOR Toman spent; each point redeems for
# LOYALTY_REDEEM_VALUE Toman of wallet credit. New accounts get the signup bonus.
LOYALTY_EARN_DIVISOR=10000
LOYALTY_REDEEM_VALUE=1000
LOYALTY_SIGNUP_BONUS=100

# ── How the apps talk to each other ───────────────────────────────────────────
# Browser → API. The browser cannot resolve Docker service names, so in dev it
# reaches the backend through the published host port (localhost:8080).
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server (Next.js container) → API. Inside Docker this is the service name.
# (Set automatically by the compose file as BACKEND_INTERNAL_URL=http://backend:8080.)

# CORS allow-list for the API (comma-separated origins).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Main database (PostgreSQL / TimescaleDB) ──────────────────────────────────
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=rumera
DB_PORT=5432                 # host port
DB_SSL_MODE=disable

# ── Analytics database (TimescaleDB) ──────────────────────────────────────────
ANALYTICS_DB_USER=postgres
ANALYTICS_DB_PASSWORD=postgres
ANALYTICS_DB_NAME=rumera_analytics
ANALYTICS_DB_HOST_PORT=5433  # host port
ANALYTICS_DB_SSL_MODE=disable

# ── Cache (Redis) ─────────────────────────────────────────────────────────────
REDIS_PORT=6379              # host port (dev runs without a password)

# ── Search (Meilisearch) ──────────────────────────────────────────────────────
MEILI_API_KEY=super_secret_key
MEILI_PORT=7700              # host port

# ── Published ports ───────────────────────────────────────────────────────────
BACKEND_PORT=8080
FRONTEND_PORT=3000
