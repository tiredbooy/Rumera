# ──────────────────────────────────────────────────────────────────────────────
# Rumera — DEVELOPMENT environment template.
#
#   cp .env.dev.example .env.dev        (or run:  make env)
#
# Used by docker-compose.dev.yml via:  docker compose --env-file .env.dev ...
#
# Every value here already has a sensible default baked into the compose file,
# so .env.dev is mostly about ONE thing you must not skip: AUTH_SECRET (the
# Next.js / next-auth signing key has no default — the frontend won't start
# without it). Everything else you can leave as-is for local development.
# ──────────────────────────────────────────────────────────────────────────────

# ── Auth (REQUIRED — no default) ──────────────────────────────────────────────
# next-auth signing secret. Generate a fresh one with:  openssl rand -base64 32
AUTH_SECRET=dev-insecure-auth-secret-change-me-0000000000000000
AUTH_URL=http://localhost:3000

# Backend JWT signing secret (issues the API access/refresh tokens).
JWT_SECRET=dev-insecure-jwt-secret-change-me
# Optional: protect GET /metrics with Authorization: Bearer <token>
# METRICS_BEARER_TOKEN=
JWT_ACCESS_TTL=15            # minutes
JWT_REFRESH_TTL=10080        # minutes (7 days)

# Bootstrap admin, created on first boot if it doesn't exist. Blank = skip.
ADMIN_EMAIL=admin@rumera.local
ADMIN_PASSWORD=admin12345

# ── SMS / OTP login ───────────────────────────────────────────────────────────
# "log" (default) just writes the OTP code to the backend logs — perfect for dev,
# no SMS account needed. Switch to "kavenegar" + a key in prod.
SMS_PROVIDER=log
# SMS_API_KEY=
# SMS_SENDER=
OTP_TTL=2m

# ── Notifications (OTP SMS + transactional email) ─────────────────────────────
# inline (default): API sends via pkg/sms + pkg/notify on the request path.
# async: API writes notification_outbox; run Kafka + notification-worker.
# Easy local path stays inline + SMS_PROVIDER=log (OTP appears in backend logs).
NOTIFICATIONS_MODE=inline
# KAFKA_BROKERS=localhost:19092
# NOTIFICATION_WORKER_GROUP=rumera-notification-worker
# NOTIFICATION_WORKER_MODE=all
#
# Async local loop:
#   make kafka-up
#   NOTIFICATIONS_MODE=async KAFKA_BROKERS=localhost:19092  (API)
#   make notification-worker

# ── Loyalty (Cellar Club) ─────────────────────────────────────────────────────
# Earn 1 point per LOYALTY_EARN_DIVISOR Toman spent; each point redeems for
# LOYALTY_REDEEM_VALUE Toman of wallet credit. New accounts get the signup bonus.
LOYALTY_EARN_DIVISOR=10000
LOYALTY_REDEEM_VALUE=1000
LOYALTY_SIGNUP_BONUS=100

# ── How the apps talk to each other ───────────────────────────────────────────
# Browser → API. The browser cannot resolve Docker service names, so in dev it
# reaches the backend through the published host port (localhost:8080).
NEXT_PUBLIC_API_URL=http://localhost:8080
# Optional; defaults to NEXT_PUBLIC_API_URL for local split-origin media.
# NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server (Next.js container) → API. Inside Docker this is the service name.
# (Set automatically by the compose file as BACKEND_INTERNAL_URL=http://backend:8080.)

# CORS allow-list for the API (comma-separated origins).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Main database (PostgreSQL / TimescaleDB) ──────────────────────────────────
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=rumera
DB_PORT=5432                 # host port
DB_SSL_MODE=disable

# ── Analytics database (TimescaleDB) ──────────────────────────────────────────
ANALYTICS_DB_USER=postgres
ANALYTICS_DB_PASSWORD=postgres
ANALYTICS_DB_NAME=rumera_analytics
ANALYTICS_DB_HOST_PORT=5433  # host port
ANALYTICS_DB_SSL_MODE=disable

# ── Cache (Redis) ─────────────────────────────────────────────────────────────
REDIS_PORT=6379              # host port (dev runs without a password)

# ── Search (Meilisearch) ──────────────────────────────────────────────────────
MEILI_API_KEY=super_secret_key
MEILI_PORT=7700              # host port

# ── Media hardening ────────────────────────────────────────────────────────────
MEDIA_MAX_UPLOAD_MB=15
MEDIA_DEFAULT_QUALITY=80
MEDIA_MAX_DIMENSION=4000
MEDIA_MAX_SOURCE_DIMENSION=12000
MEDIA_MAX_SOURCE_PIXELS=40000000

# ── Published ports ───────────────────────────────────────────────────────────
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ── Reverse proxy / unified gateway (nginx) ───────────────────────────────────
# Single origin in front of everything:  http://localhost:${GATEWAY_PORT}
#   /api/v1/* → backend   |   /* → frontend (with HMR / Fast Refresh)
# The direct :3000 / :8080 ports above still work as a fallback.
GATEWAY_PORT=80

# ── Domain events (transactional outbox) ─────────────────────────────────────
# Paid-order side effects (receipt, loyalty + referral, recs) run as idempotent
# consumers of order.paid.v1 instead of on the checkout request path. Defaults
# need no extra infrastructure — the bus consumes straight from Postgres.
#   EVENTS_ENABLED=true          # false reverts to the legacy in-request path
#   EVENTS_BUS=postgres          # kafka also needs KAFKA_BROKERS + a reachable broker
#   EVENTS_WORKER=embedded       # local default; "external" = cmd/event-worker owns them
# Full knob list: apps/backend/docs/architecture/domain-events.md
#
# To try the Kafka path locally: start apps/backend/deploy/kafka (see its header
# for the network join), then set EVENTS_BUS=kafka and KAFKA_BROKERS.

# ── API monitoring ───────────────────────────────────────────────────────────
# `make dev` starts Prometheus and Grafana with the API dashboard provisioned.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
# Change this if the dev port is reachable by anyone outside your machine.
GRAFANA_ADMIN_PASSWORD=admin
# Browser-facing link used by the admin monitoring page.
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3001
#
# Optional — route the BROWSER through the gateway too (true same-origin, no
# CORS). Browse the app at http://localhost (port 80) and set all four below to
# that origin; otherwise leave them pointed at :3000/:8080 as above.
#   NEXT_PUBLIC_API_URL=http://localhost
#   NEXT_PUBLIC_SITE_URL=http://localhost
#   AUTH_URL=http://localhost
#   CORS_ALLOWED_ORIGINS=http://localhost
