# ── Dev image: Go + Air (hot reload) ──────────────────────────────────────────
FROM golang:1.25-alpine

# gcc/musl-dev + pkgconf + vips-dev: the image pipeline links libvips (cgo)
# under the `vips` build tag (see .air.toml). curl powers the healthcheck.
RUN apk add --no-cache git gcc musl-dev curl pkgconf vips-dev

RUN go env -w GOSUMDB=off
# RUN go env -w GOPROXY=https://go.devneeds.ir,direct
# RUN go env -w GOPROXY=https://proxy.golang.org,direct
# The default Go proxy and golang.org vanity endpoints are not reachable on
# every development network. Use mirrors that are reachable here and `|`
# separators so Go falls through on any HTTP or network error.
RUN go env -w 'GOPROXY=https://goproxy.cn|https://proxy.golang.com.cn|direct'

# Install Air — pinned for reproducibility
RUN go install github.com/air-verse/air@v1.61.7

WORKDIR /app

# Copy dependency manifests — this layer is only rebuilt when go.mod/go.sum change
COPY go.mod go.sum ./

# Download modules into the image layer cache
# The go_mod_cache volume in compose also mounts /go/pkg/mod so this
# persists across container restarts without re-downloading
RUN go mod download

# Bake an initial copy of the source so the container is runnable on its own and
# Docker Compose Watch has a baseline to sync changes onto. (A bind mount, if
# used instead, simply overlays this.)
COPY . .

EXPOSE 8080

CMD ["air", "-c", ".air.toml"]
