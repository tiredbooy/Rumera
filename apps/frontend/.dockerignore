# Keep the build context small and the image clean.
node_modules
.next
out
build
coverage

# VCS & editor
.git
.gitignore
.vscode
.idea

# Env & secrets — never bake these into an image.
.env
.env.*
!.env.example

# Logs & local cruft
*.log
npm-debug.log*
.DS_Store
*.tsbuildinfo
next-env.d.ts

# Docs/CI not needed at build time
Dockerfile
Dockerfile.dev
.dockerignore
README.md
